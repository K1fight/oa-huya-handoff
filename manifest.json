{
  "manifest_version": 3,
  "name": "OA 虎牙号库登录态直通",
  "version": "1.2.0",
  "description": "从 OA 后台读取虎牙账号 Cookie，写入 huya.com 登录态后打开官方宝典页面。",
  "key": "",
  "permissions": ["cookies", "tabs", "storage"],
  "host_permissions": [
    "https://*.huya.com/*",
    "http://103.236.90.63:31000/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OA 虎牙直通（请从 OA 后台点「官网」按钮使用）",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": [
      "http://103.236.90.63:31000/*",
      "http://localhost:3000/*"
    ]
  },
  "options_page": "options.html"
}
